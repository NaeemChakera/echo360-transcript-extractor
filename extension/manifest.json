{
  "manifest_version": 3,
  "name": "Echo360 Transcript Extractor",
  "short_name": "Echo360 Transcripts",
  "version": "1.0.0",
  "description": "Download every Echo360 lecture transcript in a course as one ZIP. Works inside Canvas and other LMSs, at any university on Echo360.",
  "author": "Naeem Chakera",
  "permissions": ["downloads", "storage", "scripting", "activeTab"],
  "host_permissions": [
    "*://*.echo360.org/*",
    "*://*.echo360.org.uk/*",
    "*://*.echo360.org.au/*",
    "*://*.echo360.net.au/*",
    "*://*.echo360.ca/*",
    "*://*.echo360.com/*",
    "*://*.echo360.net/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.echo360.org/*",
        "*://*.echo360.org.uk/*",
        "*://*.echo360.org.au/*",
        "*://*.echo360.net.au/*",
        "*://*.echo360.ca/*",
        "*://*.echo360.com/*",
        "*://*.echo360.net/*"
      ],
      "js": ["lib/transcript.js", "content.js"],
      "all_frames": true,
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "Download Echo360 transcripts",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
